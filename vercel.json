{
  "rewrites": [
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/scanner/(.*)",
      "destination": "/scanner/index.html"
    },
    {
      "source": "/user/(.*)",
      "destination": "/user/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
