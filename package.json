{
  "name": "e-stamp-root",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "workspaces": [
    "hub",
    "dashboard",
    "user",
    "scanner",
    "qrcode"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names qrcode,hub,dashboard --prefix-colors cyan,blue,magenta \"npm run dev:qrcode\" \"npm run dev:hub\" \"npm run dev:dashboard\"",
    "dev:qrcode": "npm run dev --workspace=qrcode -- --port 3000",
    "dev:hub": "npm run dev --workspace=hub -- --port 5173",
    "dev:dashboard": "npm run dev --workspace=e-stamp -- --port 5174",
    "build": "npm run build --workspaces"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
